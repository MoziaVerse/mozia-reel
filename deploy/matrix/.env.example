# ── ArcReel 自身 ────────────────────────────────────────────────
# 关掉自带登录：访问控制完全由 MatrixSessionGate 承担（server/matrix_gate.py）。
# ⚠️ 只有在 MATRIX_BACKEND_URL 已配置、门禁真正生效时才可以设 false，
#    两者同时缺失 = 整站匿名可访问。
AUTH_ENABLED=false

TZ=Asia/Shanghai

# ── Matrix 握手 ─────────────────────────────────────────────────
# matrix backend 地址：/api/external/session-init 的转发目标。
# 留空会**整条关闭门禁**（本地开发用），部署时必须填。
MATRIX_BACKEND_URL=https://matrix.mzsjai.com

# matrix 前端地址：未握手的浏览器导航被引回这里
MATRIX_WEB_URL=https://matrix.mzsjai.com

# 本站在 matrix external_client 注册表里的 clientId
EXTERNAL_CLIENT_ID=mozia-reel

# 会话 cookie 的 HMAC 密钥（≥32 字符，生成：openssl rand -base64 32）
# ⚠️ 重启后变更会让所有人被登出，且这种"偶发全员掉线"很难排查——固定下来。
SESSION_COOKIE_SECRET=

# 会话有效期（秒），默认 7 天
SESSION_TTL_SECONDS=604800

# 生产走 https 时设 1；本地 http 联调必须留空，否则 Secure cookie 种不上
SESSION_COOKIE_SECURE=1
